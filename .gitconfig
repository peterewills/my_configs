[user]
	name = peter.wills
	email = peter.e.wills@gmail.com

[alias]
	nicelog = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	nicelog2 = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	unstage = reset HEAD --

[core]
	editor = emacs
	excludesfile = ~/.gitignore_global

[push]
	default = simple
	autoSetupRemote = true

[color]
	ui = auto

[github]
	user = peterewills


[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

# Route Alloy org URLs through the Alloy SSH key. Unconditional so it also applies to
# `git clone`, where there is no gitdir yet for includeIf to match.
[url "git@github-alloy:Alloy-Mining-Intelligence/"]
	insteadOf = git@github.com:Alloy-Mining-Intelligence/
	insteadOf = https://github.com/Alloy-Mining-Intelligence/

# Alloy identity and commit signing; see ~/code/README.md.
[includeIf "gitdir:~/code/alloy/"]
	path = ~/code/peter/my_configs/.gitconfig-alloy
